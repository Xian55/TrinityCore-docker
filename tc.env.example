# Optional: copy to tc.env. Every line overrides one key of worldserver.conf / bnetserver.conf /
# authserver.conf. The name is TC_ plus the key in upper snake case:
#   Rate.XP.Kill             -> TC_RATE_XP_KILL
#   LoginREST.TicketDuration -> TC_LOGIN_REST_TICKET_DURATION
#   GM.LoginState            -> TC_GM_LOGIN_STATE

#TC_RATE_XP_KILL=3
#TC_GM_LOGIN_STATE=1
#TC_PLAYER_SAVE_INTERVAL=60000

# A mostly empty realm ticks every millisecond by default; a higher floor saves CPU.
#TC_MIN_WORLD_UPDATE_TIME=10

# 4.3.4: one connection per player instead of two, for a client or proxy that does not follow
# the move to INSTANCE_PORT at character login.
#TC_LEGACY_CONNECTION_MODE_ENABLED=1
