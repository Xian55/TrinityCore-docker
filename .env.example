# Copy to .env and adjust. Two branches on one host: one env file each, e.g.
#   docker compose --env-file 3.3.5.env up -d
# with a different COMPOSE_PROJECT_NAME and ports in each.

# TrinityCore branch: cata_classic (4.4.2.60895 client) or 3.3.5 (3.3.5a client)
TC_BRANCH=cata_classic
COMPOSE_PROJECT_NAME=tc-cata

# Address the clients connect to: this host's LAN address. Sent to clients in the realm list
# and, on bnetserver, as the login portal address.
REALM_ADDRESS=127.0.0.1
REALM_NAME=Trinity

# Ports are the same inside and outside the containers, because the servers send them to clients.
# Login: 1119 for bnetserver, 3724 for the 3.3.5 authserver. REST_PORT is bnetserver only.
LOGIN_PORT=1119
REST_PORT=8081
WORLD_PORT=8085

# MySQL, published on the host for tools (127.0.0.1 only by default)
DB_BIND=127.0.0.1
DB_PORT=3306
MYSQL_ROOT_PASSWORD=change-me
TC_DB_USER=trinity
TC_DB_PASSWORD=trinity

# Client install for `docker compose --profile tools run --rm extract`: the folder holding Data/
CLIENT_DIR=./client
EXTRACT_VMAPS=1
# mmaps take hours; without them, leave ENABLE_MMAPS=0
EXTRACT_MMAPS=0
ENABLE_VMAPS=1
ENABLE_MMAPS=0

# Plaintext packet log in the logs volume; empty = off. date(1) placeholders give one file per
# worldserver start (TrinityCore truncates the file when it starts): World-%Y%m%d-%H%M%S.pkt
PACKET_LOG_FILE=
